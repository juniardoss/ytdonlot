# Salin ke .env lalu sesuaikan. Jangan commit file .env.

REDIS_URL=redis://localhost:6379/0
DOWNLOAD_DIR=./downloads

# --- Batas sumber daya ---
# Umur file sebelum dihapus otomatis (detik). 7200 = 2 jam.
FILE_TTL_SECONDS=7200
# Video lebih panjang dari ini ditolak (detik).
MAX_DURATION_SECONDS=3600
MAX_FILESIZE_MB=1024
# Job yang melebihi durasi ini dibunuh (detik).
JOB_TIMEOUT_SECONDS=900
# Job ditolak kalau ruang disk tersisa di bawah angka ini.
MIN_FREE_DISK_MB=2048

# --- Rate limit per IP ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Domain yang diizinkan (dipisah koma, subdomain otomatis ikut) ---
# Kosongkan entri yang tidak dipakai. Daftar ini adalah pertahanan utama
# terhadap SSRF -- jangan diganti dengan wildcard.
ALLOWED_DOMAINS=youtube.com,youtu.be,music.youtube.com,vimeo.com,dailymotion.com,soundcloud.com

# --- Opsional: menembus deteksi bot ---
# Isi salah satu kalau server kena "Sign in to confirm you're not a bot".
# PROXY=http://user:pass@host:port
# COOKIES_FILE=/srv/secrets/cookies.txt
